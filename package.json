{
  "name": "innova-3d-landing",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed:generate": "node scripts/generate-seed.mjs",
    "models:upload": "node scripts/upload-models.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}

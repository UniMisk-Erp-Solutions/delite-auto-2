# Public settings for the browser (Vite only exposes VITE_* variables).
# Local dev: copy to client/.env.local. Vercel: add the same names under Project -> Settings -> Environment Variables.
# Leave them empty to run fully local (Express model server + built-in sample catalogue).

# Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase -> Project Settings -> API -> "anon" / publishable key (safe for the browser; protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Optional: serve the 3D models from somewhere else (default = the Supabase bucket "models")
# VITE_MODELS_URL=https://cdn.example.com/models
